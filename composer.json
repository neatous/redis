{
	"name": "neatous/redis",
	"description": "Minimalist Redis integration for Nette cache and sessions using phpredis",
	"type": "library",
	"license": "MIT",
	"require": {
		"php": ">=8.4",
		"ext-redis": ">=6.0",
		"nette/caching": "^3.3.1 || ^4.0",
		"nette/di": "^3.2.3"
	},
	"suggest": {
		"tracy/tracy": "For Redis panel in Tracy debugger bar"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.3",
		"phpunit/phpunit": "^13.0",
		"slevomat/coding-standard": "^8.31",
		"squizlabs/php_codesniffer": "^4.0.1",
		"tracy/tracy": "^2.11"
	},
	"autoload": {
		"psr-4": {
			"Netous\\Redis\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Netous\\Redis\\Tests\\": "tests/"
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "0.10.x-dev"
		}
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
